# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/risto_ai
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/risto_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# External APIs
OPENWEATHER_API_KEY=your-openweather-api-key
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ML Model Configuration
MODEL_RETRAIN_INTERVAL_DAYS=7
PREDICTION_HORIZON_DAYS=14

# Marketing Configuration
MAX_CAMPAIGNS_PER_CUSTOMER_WEEK=1
MIN_DAYS_BETWEEN_OFFERS=7

# Reservation System
MAX_OVERBOOKING_PERCENTAGE=10
RESERVATION_CONFIRMATION_HOURS=24
